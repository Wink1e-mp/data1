# =============================================================================
# Шаблон переменных окружения.
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# Файл .env добавлен в .gitignore — НЕ публикуйте его в git!
# =============================================================================

# Токен бота, который выдал @BotFather (формат: 123456789:AA... )
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Ваш личный chat_id (узнать: напишите @userinfobot). Может быть отрицательным для групп.
ADMIN_CHAT_ID=123456789

# URL задеплоенного Google Apps Script (Web App), оканчивается на /exec.
# Именно на него бот отправит POST с JSON {name, phone, request}.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
